---
// Banner memorial - 24 de Marzo
---

<div class="bg-[#74ACDF]/5 border-b border-[#74ACDF]/20">
  <div class="max-w-4xl mx-auto px-4 py-3">
    <div class="flex items-center justify-center gap-4">
      <!-- Cinta celeste y blanca izquierda -->
      <div class="hidden sm:flex items-center gap-1">
        <div class="w-3 h-6 bg-[#74ACDF] rounded-sm"></div>
        <div class="w-3 h-6 bg-white rounded-sm"></div>
      </div>

      <div class="h-px flex-1 bg-gradient-to-r from-transparent via-[#74ACDF]/40 to-transparent"></div>

      <div class="text-center">
        <p class="text-xs font-mono text-[#74ACDF] tracking-[0.2em] uppercase font-semibold">
          24 de Marzo
        </p>
        <p class="text-sm text-foreground/80 mt-0.5">
          Dia Nacional de la Memoria, la Verdad y la Justicia
        </p>
      </div>

      <div class="h-px flex-1 bg-gradient-to-r from-transparent via-[#74ACDF]/40 to-transparent"></div>

      <!-- Cinta celeste y blanca derecha -->
      <div class="hidden sm:flex items-center gap-1">
        <div class="w-3 h-6 bg-white rounded-sm"></div>
        <div class="w-3 h-6 bg-[#74ACDF] rounded-sm"></div>
      </div>
    </div>
  </div>
</div>
