---
// El chat se hidrata en el cliente con un <script>
// No usa framework JS - vanilla JS puro para mínimo bundle
---

<div id="chat-container" class="max-w-3xl mx-auto flex flex-col h-full px-4 py-6">
  <!-- Mensajes -->
  <div id="messages" class="flex-1 overflow-y-auto space-y-4 pb-4">
    <!-- Mensaje de bienvenida -->
    <div class="chat-bubble-bot">
      <p class="font-medium mb-2">Bienvenido/a</p>
      <p class="text-sm text-gray-600">
        Podés consultar información de los <strong>archivos desclasificados de la SIDE</strong>
        (1973-1983) y el <strong>Registro de Víctimas del Terrorismo de Estado</strong> (RUVTE).
      </p>
      <p class="text-sm text-gray-600 mt-2">
        Elegí un ejemplo o escribí tu pregunta:
      </p>
    </div>

    <!-- Ejemplos clickeables -->
    <div id="examples" class="flex flex-wrap gap-2">
      <button class="example-btn bg-primary-50 text-primary-800 text-sm px-3 py-2 rounded-lg border border-primary-200 hover:bg-primary-100 transition-colors text-left">
        Qué tipo de documentos desclasificó la SIDE?
      </button>
      <button class="example-btn bg-primary-50 text-primary-800 text-sm px-3 py-2 rounded-lg border border-primary-200 hover:bg-primary-100 transition-colors text-left">
        Cuántas víctimas registra el RUVTE en Buenos Aires?
      </button>
      <button class="example-btn bg-primary-50 text-primary-800 text-sm px-3 py-2 rounded-lg border border-primary-200 hover:bg-primary-100 transition-colors text-left">
        Qué dicen los archivos sobre la organización de la SIDE?
      </button>
      <button class="example-btn bg-primary-50 text-primary-800 text-sm px-3 py-2 rounded-lg border border-primary-200 hover:bg-primary-100 transition-colors text-left">
        Hay información sobre desaparecidos en Córdoba?
      </button>
    </div>
  </div>

  <!-- Input -->
  <div class="border-t border-gray-200 pt-4">
    <form id="chat-form" class="flex gap-2">
      <input
        id="chat-input"
        type="text"
        placeholder="Escribí tu consulta sobre la dictadura..."
        maxlength="500"
        class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-sm"
        autocomplete="off"
      />
      <button
        type="submit"
        id="send-btn"
        class="bg-primary-600 text-white px-5 py-3 rounded-xl hover:bg-primary-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed text-sm font-medium"
      >
        Enviar
      </button>
    </form>
    <p class="text-xs text-gray-400 mt-2 text-center">
      Las respuestas se basan exclusivamente en documentos oficiales. No genera información inventada.
    </p>
  </div>
</div>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || "https://history-arg-api.project-backoffice.workers.dev";

  const messagesEl = document.getElementById("messages");
  const form = document.getElementById("chat-form");
  const input = document.getElementById("chat-input") as HTMLInputElement;
  const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;
  const examplesEl = document.getElementById("examples");

  // Ejemplos clickeables
  examplesEl?.querySelectorAll(".example-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      input.value = btn.textContent?.trim() || "";
      form?.dispatchEvent(new Event("submit"));
    });
  });

  // Enviar consulta
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const query = input.value.trim();
    if (!query) return;

    // Ocultar ejemplos después del primer uso
    if (examplesEl) examplesEl.style.display = "none";

    // Mostrar mensaje del usuario
    addMessage(query, "user");
    input.value = "";
    sendBtn.disabled = true;

    // Crear burbuja de respuesta
    const botBubble = addMessage("", "bot");
    const textEl = botBubble.querySelector(".response-text")!;
    const sourcesEl = botBubble.querySelector(".response-sources")!;
    textEl.classList.add("typing-cursor");

    try {
      const res = await fetch(`${API_URL}/api/chat`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query }),
      });

      if (!res.ok) {
        const err = await res.json();
        textEl.textContent = `Error: ${err.error || "No se pudo procesar la consulta."}`;
        textEl.classList.remove("typing-cursor");
        sendBtn.disabled = false;
        return;
      }

      // Leer stream SSE
      const reader = res.body!.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      let fullText = "";

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split("\n\n");
        buffer = lines.pop() || "";

        for (const line of lines) {
          if (!line.startsWith("data: ")) continue;
          try {
            const event = JSON.parse(line.slice(6));

            if (event.type === "sources") {
              renderSources(sourcesEl, event.data);
            } else if (event.type === "token") {
              fullText += event.data;
              textEl.innerHTML = formatMarkdown(fullText);
            } else if (event.type === "done") {
              textEl.classList.remove("typing-cursor");
            } else if (event.type === "error") {
              textEl.textContent += `\n\nError: ${event.data}`;
              textEl.classList.remove("typing-cursor");
            }
          } catch {
            // Skip malformed events
          }
        }
      }
    } catch (err) {
      textEl.textContent = "Error de conexión. Verificá tu conexión a internet e intentá de nuevo.";
      textEl.classList.remove("typing-cursor");
    }

    sendBtn.disabled = false;
    scrollToBottom();
  });

  function addMessage(text: string, role: "user" | "bot"): HTMLElement {
    const div = document.createElement("div");

    if (role === "user") {
      div.className = "chat-bubble-user";
      div.textContent = text;
    } else {
      div.className = "chat-bubble-bot";
      div.innerHTML = `
        <div class="response-text prose-response text-sm"></div>
        <div class="response-sources mt-3 hidden"></div>
      `;
    }

    messagesEl?.appendChild(div);
    scrollToBottom();
    return div;
  }

  function renderSources(container: Element, sources: any[]) {
    if (!sources || sources.length === 0) return;

    container.classList.remove("hidden");
    container.innerHTML = `
      <details class="text-xs">
        <summary class="cursor-pointer text-gray-500 hover:text-gray-700 font-medium">
          Fuentes consultadas (${sources.length})
        </summary>
        <ul class="mt-2 space-y-1 text-gray-600">
          ${sources
            .map(
              (s) => `
            <li class="flex items-start gap-1">
              <span class="font-mono text-primary-600">[${s.num}]</span>
              <span>
                <strong>${s.source}</strong>${s.title ? ` - ${s.title}` : ""}${s.date ? ` (${s.date})` : ""}
                <span class="text-gray-400 ml-1">relevancia: ${(s.score * 100).toFixed(0)}%</span>
              </span>
            </li>
          `
            )
            .join("")}
        </ul>
      </details>
    `;
  }

  function formatMarkdown(text: string): string {
    return text
      .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
      .replace(/\n\n/g, "</p><p>")
      .replace(/\n/g, "<br>")
      .replace(/^/, "<p>")
      .replace(/$/, "</p>");
  }

  function scrollToBottom() {
    messagesEl?.scrollTo({ top: messagesEl.scrollHeight, behavior: "smooth" });
  }
</script>
