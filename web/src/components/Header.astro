---
// Header - Archivos Desclasificados Argentina
---

<header class="border-b border-border/50 bg-card/80 backdrop-blur-sm sticky top-0 z-50">
  <!-- Franja bandera argentina -->
  <div class="h-1 w-full flex">
    <div class="flex-1 bg-[#74ACDF]"></div>
    <div class="flex-1 bg-white"></div>
    <div class="flex-1 bg-[#74ACDF]"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-4">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-[#74ACDF]/15 rounded border border-[#74ACDF]/30">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#74ACDF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
          <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
          <path d="M10 9H8"/>
          <path d="M16 13H8"/>
          <path d="M16 17H8"/>
        </svg>
      </div>
      <div>
        <h1 class="text-lg font-semibold text-foreground tracking-tight">
          Archivos Desclasificados
        </h1>
        <p class="text-xs text-muted-foreground font-mono">
          DICTADURA ARGENTINA 1976-1983
        </p>
      </div>

      <!-- Sol de Mayo -->
      <div class="ml-auto hidden sm:block">
        <svg viewBox="0 0 40 40" class="w-8 h-8" fill="#F6B40E">
          <circle cx="20" cy="20" r="6" />
          <line x1="20" y1="4" x2="20" y2="12" stroke="#F6B40E" stroke-width="2" stroke-linecap="round"/>
          <line x1="20" y1="28" x2="20" y2="36" stroke="#F6B40E" stroke-width="2" stroke-linecap="round"/>
          <line x1="4" y1="20" x2="12" y2="20" stroke="#F6B40E" stroke-width="2" stroke-linecap="round"/>
          <line x1="28" y1="20" x2="36" y2="20" stroke="#F6B40E" stroke-width="2" stroke-linecap="round"/>
          <line x1="8.69" y1="8.69" x2="14.34" y2="14.34" stroke="#F6B40E" stroke-width="2" stroke-linecap="round"/>
          <line x1="25.66" y1="25.66" x2="31.31" y2="31.31" stroke="#F6B40E" stroke-width="2" stroke-linecap="round"/>
          <line x1="8.69" y1="31.31" x2="14.34" y2="25.66" stroke="#F6B40E" stroke-width="2" stroke-linecap="round"/>
          <line x1="25.66" y1="14.34" x2="31.31" y2="8.69" stroke="#F6B40E" stroke-width="2" stroke-linecap="round"/>
          <line x1="20" y1="6" x2="20" y2="10" stroke="#F6B40E" stroke-width="1.5" stroke-linecap="round" transform="rotate(22.5 20 20)"/>
          <line x1="20" y1="6" x2="20" y2="10" stroke="#F6B40E" stroke-width="1.5" stroke-linecap="round" transform="rotate(67.5 20 20)"/>
          <line x1="20" y1="6" x2="20" y2="10" stroke="#F6B40E" stroke-width="1.5" stroke-linecap="round" transform="rotate(112.5 20 20)"/>
          <line x1="20" y1="6" x2="20" y2="10" stroke="#F6B40E" stroke-width="1.5" stroke-linecap="round" transform="rotate(157.5 20 20)"/>
          <line x1="20" y1="6" x2="20" y2="10" stroke="#F6B40E" stroke-width="1.5" stroke-linecap="round" transform="rotate(202.5 20 20)"/>
          <line x1="20" y1="6" x2="20" y2="10" stroke="#F6B40E" stroke-width="1.5" stroke-linecap="round" transform="rotate(247.5 20 20)"/>
          <line x1="20" y1="6" x2="20" y2="10" stroke="#F6B40E" stroke-width="1.5" stroke-linecap="round" transform="rotate(292.5 20 20)"/>
          <line x1="20" y1="6" x2="20" y2="10" stroke="#F6B40E" stroke-width="1.5" stroke-linecap="round" transform="rotate(337.5 20 20)"/>
        </svg>
      </div>
    </div>
  </div>
</header>
