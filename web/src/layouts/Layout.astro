---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Consultá archivos desclasificados de la dictadura cívico-militar argentina (1976-1983)" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="bg-white border-b border-gray-200 px-4 py-3">
      <nav class="max-w-3xl mx-auto flex items-center justify-between">
        <a href="/" class="font-bold text-lg text-gray-900 hover:text-primary-700 transition-colors">
          Archivos Desclasificados
        </a>
        <div class="flex gap-4 text-sm">
          <a href="/" class="text-gray-600 hover:text-primary-700 transition-colors">Consultar</a>
          <a href="/acerca" class="text-gray-600 hover:text-primary-700 transition-colors">Acerca</a>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-gray-200 px-4 py-4 text-center text-xs text-gray-500">
      <p>
        Proyecto de acceso abierto. Las respuestas se basan en documentos oficiales desclasificados.
        <a href="https://github.com/TU_USUARIO/History-ARG" target="_blank" class="text-primary-600 hover:underline">Codigo fuente</a>
      </p>
    </footer>
  </body>
</html>
